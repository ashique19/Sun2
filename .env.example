APP_NAME=Sundoritoma
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=bn
APP_STOREFRONT_LOCALE=bn
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sun2
DB_USERNAME=root
DB_PASSWORD=

DB_LEGACY_DATABASE=sun_legacy
DB_LEGACY_USERNAME=root
DB_LEGACY_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

# Inbox realtime (Laravel Reverb + Echo). Requires:
# - composer package pusher/pusher-php-server (Reverb uses the Pusher protocol)
# - BROADCAST_CONNECTION=reverb and a running `php artisan reverb:start`
# - VITE_REVERB_* keys rebuilt into the frontend
# When BROADCAST_CONNECTION=reverb, CHANNEL_INBOX_REALTIME defaults on and Graph poll slows.
# If Reverb/Pusher is not set up, keep BROADCAST_CONNECTION=log (inbox still works via Graph poll).
# CHANNEL_INBOX_REALTIME=true
# CHANNEL_INBOX_GRAPH_POLL_SECONDS=45
# CHANNEL_INBOX_GRAPH_POLL_SECONDS_REALTIME=60
# CHANNEL_INBOX_GRAPH_POLL_CONVERSATIONS=15
# CHANNEL_INBOX_GRAPH_POLL_MESSAGES=8

# REVERB_APP_ID=sun2
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
# REVERB_HOST=localhost
# REVERB_PORT=8080
# REVERB_SCHEME=http
# REVERB_SERVER_HOST=0.0.0.0
# REVERB_SERVER_PORT=8080

# VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
# VITE_REVERB_HOST="${REVERB_HOST}"
# VITE_REVERB_PORT="${REVERB_PORT}"
# VITE_REVERB_SCHEME="${REVERB_SCHEME}"

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Checkout
CHECKOUT_DHAKA_CITY_UPTO_5=80
CHECKOUT_DHAKA_CITY_OVER_5=150
CHECKOUT_OUTSIDE_UPTO_5=120
CHECKOUT_OUTSIDE_OVER_5=200
CHECKOUT_OTP_TTL=10

# Steadfast Courier (order dispatch + webhooks)
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
STEADFAST_BASE_URL=https://portal.packzy.com/api/v1
STEADFAST_TIMEOUT=30
STEADFAST_WEBHOOK_ENABLED=true
STEADFAST_WEBHOOK_TOKEN=
# Callback URL for Steadfast portal: {APP_URL}/api/steadfast/webhook

# Optional: hosting panel cron can hit /internal/sitemap/rebuild?token=...
SITEMAP_REBUILD_TOKEN=

# Optional: hosting panel cron can hit /internal/product-image-hashes/rebuild?token=...
PRODUCT_IMAGE_HASH_REBUILD_TOKEN=
PRODUCT_IMAGE_HASH_CHUNK_SIZE=25

GEMINI_API_KEY=
# Optional extra keys tried in order after GEMINI_API_KEY (comma-separated)
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash
# Text/JSON failover (inbox + paste parse). Flash first; override to add Pro if desired.
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-3.1-flash-lite,gemini-3-flash-preview,gemini-2.0-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Image failover (product AI photos). Generally paid; Flash first, Pro last.
GEMINI_IMAGE_MODELS=gemini-2.5-flash-image,gemini-3.1-flash-image,gemini-3.1-flash-image-preview,gemini-3-pro-image,gemini-3-pro-image-preview
GEMINI_IMAGE_TIMEOUT=90

# Pathao Courier API
PATHAO_ENABLED=false
PATHAO_ENVIRONMENT=sandbox
PATHAO_BASE_URL=https://courier-api-sandbox.pathao.com
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
SCRAP_PATHAO=false
PATHAO_MERCHANT_BASE_URL=https://merchant.pathao.com
PATHAO_SCRAP_TIMEOUT=20
PATHAO_STORE_ID=
PATHAO_DELIVERY_TYPE=48
PATHAO_ITEM_TYPE=2
PATHAO_DEFAULT_WEIGHT=0.5
PATHAO_WEBHOOK_ENABLED=true
PATHAO_WEBHOOK_SECRET=
PATHAO_WEBHOOK_INTEGRATION_SECRET=
# Callback URL: {APP_URL}/api/webhooks/pathao

# RedX Courier API
REDX_ENABLED=false
REDX_BASE_URL=https://openapi.redx.com.bd/v1.0.0-beta
REDX_API_TOKEN=
REDX_PICKUP_STORE_ID=
REDX_DEFAULT_WEIGHT=1
REDX_WEBHOOK_ENABLED=true
REDX_WEBHOOK_TOKEN=
# Callback URL: {APP_URL}/api/webhooks/redx?token={REDX_WEBHOOK_TOKEN}

# CarryBee Courier API
CARRYBEE_ENABLED=false
CARRYBEE_ENVIRONMENT=sandbox
CARRYBEE_BASE_URL=https://stage-sandbox.carrybee.com
CARRYBEE_CLIENT_ID=
CARRYBEE_CLIENT_SECRET=
CARRYBEE_CLIENT_CONTEXT=
CARRYBEE_STORE_ID=
CARRYBEE_DELIVERY_TYPE=1
CARRYBEE_PRODUCT_TYPE=1
CARRYBEE_DEFAULT_WEIGHT_GRAMS=500
CARRYBEE_WEBHOOK_ENABLED=true
CARRYBEE_WEBHOOK_SECRET=
# Callback URL: {APP_URL}/api/webhooks/carrybee

# Google Analytics (storefront gtag.js)
GOOGLE_ANALYTICS_ID=G-0C9GKKCSKJ

# Meta Pixel (storefront Facebook Pixel)
META_PIXEL_ID=952667959398529

# Facebook Messenger (Page inbox webhook)
FACEBOOK_MESSENGER_WEBHOOK_ENABLED=true
# Pick any long random string; paste the SAME value into Meta's "Verify token" field.
FACEBOOK_MESSENGER_VERIFY_TOKEN=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_GRAPH_VERSION=v25.0
# Callback URL for Meta: {APP_URL}/api/webhooks/messenger
# Graph catch-up while /admin/inbox is open (Livewire poll every 10s).
# Optional server cron (off by default): * * * * * php artisan schedule:run
FACEBOOK_MESSENGER_AUTO_SYNC_ENABLED=false
# Optional: hosting panel cron can hit /internal/messenger/sync-conversations?token=...
FACEBOOK_MESSENGER_SYNC_TOKEN=

# AI draft parser (on-demand via ChannelOrderDraftService; not auto from webhook/sync)
CHANNEL_AI_DRAFT_LOOKBACK_HOURS=48
CHANNEL_AI_DRAFT_MAX_MESSAGES=15
CHANNEL_AI_DRAFT_MIN_CONFIDENCE=0.5
CHANNEL_AI_DRAFT_REQUIRE_PHONE=true

# Inbox retention: delete inactive conversations older than N days
CHANNEL_INBOX_RETENTION_DAYS=7
CHANNEL_INBOX_PURGE_ON_LOAD=true
# Optional daily: php artisan schedule:run → channels:purge-inbox
CHANNEL_INBOX_PURGE_SCHEDULE_ENABLED=true

# SMS (log driver writes OTP to storage/logs/laravel.log in local dev)
SMS_DRIVER=log
SMS_FROM=Sundoritoma
SMS_SSL_WIRELESS_URL=https://smsplus.sslwireless.com/api/v3/send-sms
SMS_SSL_WIRELESS_TOKEN=
SMS_SSL_WIRELESS_SID=
# MiMSMS OTP SMS (transactional type T; message body must include SMS_FROM brand name)
# Promotional SMS uses type P (SMS_MIMSMS_PROMO_TYPE); optional CampaignId for analytics
SMS_MIMSMS_URL=https://api.mimsms.com/api/V2/SMS
SMS_MIMSMS_USERNAME=
SMS_MIMSMS_API_KEY=
SMS_MIMSMS_SENDER_NAME=
SMS_MIMSMS_PROMO_TYPE=P
SMS_MIMSMS_PROMO_CAMPAIGN_ID=

